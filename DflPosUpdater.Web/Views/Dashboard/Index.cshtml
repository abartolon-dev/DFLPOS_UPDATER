@functions {
    string CssEstado(DespliegueEstado estado) => estado switch
    {
        DespliegueEstado.Exitoso => "label label-success",
        DespliegueEstado.Fallido => "label label-danger",
        DespliegueEstado.EnProceso => "label label-warning",
        DespliegueEstado.Reintentando => "label label-info",
        DespliegueEstado.Cancelado => "text-bg-secondary",
        _ => "text-bg-light text-dark"
    };
}
