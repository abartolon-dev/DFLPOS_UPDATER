@model VersionDetalleViewModel
@{
    ViewData["Title"] = "Detalle de version";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3">Version @Model.Version.NumeroVersion</h1>
        <div class="text-muted">@Model.Version.Descripcion</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="ConfiguracionArchivos" asp-action="Editar" asp-route-id="@Model.Version.Id">Configurar archivos</a>
        <form asp-action="Publicar" asp-route-id="@Model.Version.Id" method="post" data-confirm="true" data-confirm-title="Publicar version" data-confirm-text="Se crearan despliegues para las sucursales activas." data-confirm-button="Si, publicar">
            <button type="submit" class="btn btn-success">Publicar a sucursales activas</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Estado</div><div class="fw-bold">@Model.Version.Estado</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Archivos</div><div class="fw-bold">@Model.Version.TotalArchivos</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Tamano total</div><div class="fw-bold">@FormatBytes(Model.Version.TamanoBytes)</div></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Publicacion</div><div class="fw-bold">@Model.Version.FechaPublicacion?.ToString("yyyy-MM-dd HH:mm")</div></div></div></div>
</div>

<div class="card mb-4">
    <div class="card-header">Archivos configurados</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 js-datatable">
            <thead>
            <tr>
                <th>Ruta relativa</th>
                <th>Tamano</th>
                <th>SHA256</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var archivo in Model.Version.Archivos.OrderBy(x => x.RutaRelativa))
            {
                <tr>
                    <td><code>@archivo.RutaRelativa</code></td>
                    <td>@FormatBytes(archivo.TamanoBytes)</td>
                    <td class="small text-break">@archivo.Sha256</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header">Despliegues por sucursal</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-datatable">
            <thead>
            <tr>
                <th>Sucursal</th>
                <th>Estado</th>
                <th>Intentos</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Error</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Despliegues)
            {
                <tr>
                    <td>@item.Sucursal?.Nombre</td>
                    <td><span class="badge @CssEstado(item.Estado)">@item.Estado</span></td>
                    <td>@item.Intentos</td>
                    <td>@item.FechaInicio?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.FechaFin?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-danger small">@item.MensajeError</td>
                    <td><a asp-controller="Despliegues" asp-action="Detalle" asp-route-id="@item.Id">Ver logs</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string CssEstado(DespliegueEstado estado) => estado switch
    {
        DespliegueEstado.Exitoso => "text-bg-success",
        DespliegueEstado.Fallido => "text-bg-danger",
        DespliegueEstado.EnProceso => "text-bg-warning",
        DespliegueEstado.Reintentando => "text-bg-info",
        DespliegueEstado.Cancelado => "text-bg-secondary",
        _ => "text-bg-light text-dark"
    };

    string FormatBytes(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / 1024d / 1024d:N2} MB";
        if (bytes >= 1024) return $"{bytes / 1024d:N2} KB";
        return $"{bytes} B";
    }
}
