@model IEnumerable<VersionApp>
@{
    ViewData["Title"] = "Versiones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Versiones</h1>
    <a class="btn btn-primary" asp-action="Crear">Crear nueva version</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 js-datatable">
            <thead>
            <tr>
                <th>Version</th>
                <th>Estado</th>
                <th>Fecha creacion</th>
                <th>Fecha publicacion</th>
                <th>Archivos</th>
                <th>Tamano</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.NumeroVersion</td>
                    <td>@item.Estado</td>
                    <td>@item.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.FechaPublicacion?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.TotalArchivos</td>
                    <td>@FormatBytes(item.TamanoBytes)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@item.Id">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="ConfiguracionArchivos" asp-action="Editar" asp-route-id="@item.Id">Archivos</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string FormatBytes(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / 1024d / 1024d:N2} MB";
        if (bytes >= 1024) return $"{bytes / 1024d:N2} KB";
        return $"{bytes} B";
    }
}
