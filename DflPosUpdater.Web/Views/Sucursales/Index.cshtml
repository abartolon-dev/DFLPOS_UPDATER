@model IEnumerable<Sucursal>
@{
    ViewData["Title"] = "Sucursales";
}
<div class="normalheader transition animated fadeIn">
    <div class="hpanel">
        <div class="panel-body">
            <h2 class="font-light m-b-xs">
                Sucursales
            </h2>
            <small>Lista de sucursales configuradas con FTP.</small>
        </div>
    </div>
</div>

<div class="content animate-panel">
    <div class="row">
        <div class="col-lg-12">
            <div class="hpanel hblue">
                <div class="panel-heading hbuilt">
                    <div class="pull-right">
                        <a class="btn btn-info btn-xs"
                           asp-action="Crear">
                            Nueva sucursal
                        </a>
                    </div>
                    Lista de sucursales
                </div>
                <div class="hpanel">
                    <div class="panel-body">
                        <div class="animate-panel" data-effect="zoomIn">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered table-hover js-datatable">
                                            <thead>
                                                <tr>
                                                    <th>Código</th>
                                                    <th>Nombre</th>
                                                    <th>FTP</th>
                                                    <th>Ruta</th>
                                                    <th>Activa</th>
                                                    <th>Última versión</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.Codigo</td>
                                                        <td>@item.Nombre</td>
                                                        <td>@item.HostFtp:@item.PuertoFtp</td>
                                                        <td>@item.RutaDestino</td>
                                                        <td>
                                                            @if (item.Activa == true)
                                                            {
                                                                <i class="fa fa-check text-info"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fa fa-times"></i>
                                                            }

                                                        </td>                                                     
                                                        <td>@item.UltimaVersionInstalada</td>                                                      
                                                        <td>
                                                            <form asp-action="CambiarEstado" asp-route-id="@item.Id" method="post" class="d-inline" data-confirm="true" data-confirm-title="Cambiar estado" data-confirm-text="Se modificara el estado activo/inactivo de esta sucursal." data-confirm-button="Si, continuar">
                                                                <a class="btn btn-xs btn-outline btn-info" asp-action="Editar" asp-route-id="@item.Id"><i class="fa fa-pencil-square-o" aria-hidden="true"></i> Editar</a>
                                                                <button type="submit" class="btn btn-xs btn-outline btn-warning">@(item.Activa ? "Desactivar" : "Activar")</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>



