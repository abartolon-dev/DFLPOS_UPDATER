@model Sucursal

<form method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="Id" type="hidden" />

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="Activa" class="form-check-input" />
                    <label asp-for="Activa" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <hr />

        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="HostFtp" class="form-label"></label>
                <input asp-for="HostFtp" class="form-control" placeholder="192.168.1.10 o ftp.midominio.com" />
                <span asp-validation-for="HostFtp" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="PuertoFtp" class="form-label"></label>
                <input asp-for="PuertoFtp" class="form-control" />
                <span asp-validation-for="PuertoFtp" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="RutaDestino" class="form-label"></label>
                <input asp-for="RutaDestino" class="form-control" />
                <span asp-validation-for="RutaDestino" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="UsuarioFtp" class="form-label"></label>
                <input asp-for="UsuarioFtp" class="form-control" />
                <span asp-validation-for="UsuarioFtp" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PasswordFtp" class="form-label"></label>
                <input asp-for="PasswordFtp" class="form-control" />
                <span asp-validation-for="PasswordFtp" class="text-danger"></span>
            </div>
            <div class="col-md-12">
                <div class="form-check">
                    <input asp-for="UsarFtps" class="form-check-input" />
                    <label asp-for="UsarFtps" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>

